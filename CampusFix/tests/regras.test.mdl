mdl 1;

/**
 * @test RF02 criação com autor data e estado automáticos
 * @expect $P != empty
 * @expect $P/Estado = CampusFix.Estado.Novo
 * @expect $P/DataCriacao != empty
 * @expect $P/DataConclusao = empty
 * @expect $P/CampusFix.Pedido_Criador = $A
 * @cleanup rollback
 */
$F = call microflow CampusFixTest.CriarFixture();
retrieve $P from $F/CampusFixTest.Fixture_Pedido;
retrieve $A from $F/CampusFixTest.Fixture_A;
retrieve $B from $F/CampusFixTest.Fixture_B;
retrieve $T1 from $F/CampusFixTest.Fixture_T1;
retrieve $T2 from $F/CampusFixTest.Fixture_T2;
retrieve $Cat from $F/CampusFixTest.Fixture_Categoria;

/

/**
 * @test RF03 outro utilizador não pode consultar o pedido
 * @expect $Permitido = false
 * @cleanup rollback
 */
$F = call microflow CampusFixTest.CriarFixture();
retrieve $P from $F/CampusFixTest.Fixture_Pedido;
retrieve $A from $F/CampusFixTest.Fixture_A;
retrieve $B from $F/CampusFixTest.Fixture_B;
retrieve $T1 from $F/CampusFixTest.Fixture_T1;
retrieve $T2 from $F/CampusFixTest.Fixture_T2;
retrieve $Cat from $F/CampusFixTest.Fixture_Categoria;
$Permitido = call microflow CampusFix.SUB_Pedido_PodeConsultar(Pedido = $P, Actor = $B);
/

/**
 * @test RF05 utilizador comum não pode assumir pedido
 * @expect $Assumiu = false
 * @expect $P/CampusFix.Pedido_Tecnico = empty
 * @cleanup rollback
 */
$F = call microflow CampusFixTest.CriarFixture();
retrieve $P from $F/CampusFixTest.Fixture_Pedido;
retrieve $A from $F/CampusFixTest.Fixture_A;
retrieve $B from $F/CampusFixTest.Fixture_B;
retrieve $T1 from $F/CampusFixTest.Fixture_T1;
retrieve $T2 from $F/CampusFixTest.Fixture_T2;
retrieve $Cat from $F/CampusFixTest.Fixture_Categoria;
$Assumiu = call microflow CampusFix.SUB_Pedido_Assumir(Pedido = $P, Actor = $A);
/

/**
 * @test RF05 técnico assume e o segundo técnico não substitui
 * @expect $Primeiro = true
 * @expect $Segundo = false
 * @expect $P/CampusFix.Pedido_Tecnico = $T1
 * @expect $P/Estado = CampusFix.Estado.EmAnalise
 * @cleanup rollback
 */
$F = call microflow CampusFixTest.CriarFixture();
retrieve $P from $F/CampusFixTest.Fixture_Pedido;
retrieve $A from $F/CampusFixTest.Fixture_A;
retrieve $B from $F/CampusFixTest.Fixture_B;
retrieve $T1 from $F/CampusFixTest.Fixture_T1;
retrieve $T2 from $F/CampusFixTest.Fixture_T2;
retrieve $Cat from $F/CampusFixTest.Fixture_Categoria;
$Primeiro = call microflow CampusFix.SUB_Pedido_Assumir(Pedido = $P, Actor = $T1);
$Segundo = call microflow CampusFix.SUB_Pedido_Assumir(Pedido = $P, Actor = $T2);
/

/**
 * @test RF05 só o técnico atribuído inicia tratamento
 * @expect $Assumiu = true
 * @expect $Errado = false
 * @expect $Correto = true
 * @expect $P/Estado = CampusFix.Estado.EmTratamento
 * @cleanup rollback
 */
$F = call microflow CampusFixTest.CriarFixture();
retrieve $P from $F/CampusFixTest.Fixture_Pedido;
retrieve $A from $F/CampusFixTest.Fixture_A;
retrieve $B from $F/CampusFixTest.Fixture_B;
retrieve $T1 from $F/CampusFixTest.Fixture_T1;
retrieve $T2 from $F/CampusFixTest.Fixture_T2;
retrieve $Cat from $F/CampusFixTest.Fixture_Categoria;
$Assumiu = call microflow CampusFix.SUB_Pedido_Assumir(Pedido = $P, Actor = $T1);
$Errado = call microflow CampusFix.SUB_Pedido_IniciarTratamento(Pedido = $P, Actor = $T2);
$Correto = call microflow CampusFix.SUB_Pedido_IniciarTratamento(Pedido = $P, Actor = $T1);
/

/**
 * @test RF07 concluir regista data nota e não repete a conclusão
 * @expect $Feito = true
 * @expect $Repetido = false
 * @expect $P/Estado = CampusFix.Estado.Resolvido
 * @expect $P/DataConclusao != empty
 * @expect count($Notas) = 1
 * @cleanup rollback
 */
$F = call microflow CampusFixTest.CriarFixture();
retrieve $P from $F/CampusFixTest.Fixture_Pedido;
retrieve $A from $F/CampusFixTest.Fixture_A;
retrieve $B from $F/CampusFixTest.Fixture_B;
retrieve $T1 from $F/CampusFixTest.Fixture_T1;
retrieve $T2 from $F/CampusFixTest.Fixture_T2;
retrieve $Cat from $F/CampusFixTest.Fixture_Categoria;
$Assumiu = call microflow CampusFix.SUB_Pedido_Assumir(Pedido = $P, Actor = $T1);
$Form = create CampusFix.FormularioResolucao (Texto = 'Fonte de alimentação substituída.', CampusFix.FormularioResolucao_Pedido = $P);
$Feito = call microflow CampusFix.SUB_Pedido_Concluir(Formulario = $Form, Actor = $T1);
$Repetido = call microflow CampusFix.SUB_Pedido_Concluir(Formulario = $Form, Actor = $T1);
retrieve $Notas from CampusFix.Comentario where [CampusFix.Comentario_Pedido = $P];
/

/**
 * @test RF07 impede conclusão sem nota de resolução
 * @expect $Feito = false
 * @expect $P/DataConclusao = empty
 * @cleanup rollback
 */
$F = call microflow CampusFixTest.CriarFixture();
retrieve $P from $F/CampusFixTest.Fixture_Pedido;
retrieve $A from $F/CampusFixTest.Fixture_A;
retrieve $B from $F/CampusFixTest.Fixture_B;
retrieve $T1 from $F/CampusFixTest.Fixture_T1;
retrieve $T2 from $F/CampusFixTest.Fixture_T2;
retrieve $Cat from $F/CampusFixTest.Fixture_Categoria;
$Assumiu = call microflow CampusFix.SUB_Pedido_Assumir(Pedido = $P, Actor = $T1);
$Form = create CampusFix.FormularioResolucao (Texto = ' ', CampusFix.FormularioResolucao_Pedido = $P);
$Feito = call microflow CampusFix.SUB_Pedido_Concluir(Formulario = $Form, Actor = $T1);
/

/**
 * @test RF04 não edita pedido resolvido
 * @expect $Resultado = empty
 * @expect $P/Titulo = 'Computador não liga'
 * @cleanup rollback
 */
$F = call microflow CampusFixTest.CriarFixture();
retrieve $P from $F/CampusFixTest.Fixture_Pedido;
retrieve $A from $F/CampusFixTest.Fixture_A;
retrieve $B from $F/CampusFixTest.Fixture_B;
retrieve $T1 from $F/CampusFixTest.Fixture_T1;
retrieve $T2 from $F/CampusFixTest.Fixture_T2;
retrieve $Cat from $F/CampusFixTest.Fixture_Categoria;
$Assumiu = call microflow CampusFix.SUB_Pedido_Assumir(Pedido = $P, Actor = $T1);
$Resolucao = create CampusFix.FormularioResolucao (Texto = 'Reparação confirmada.', CampusFix.FormularioResolucao_Pedido = $P);
$Feito = call microflow CampusFix.SUB_Pedido_Concluir(Formulario = $Resolucao, Actor = $T1);
$Form = create CampusFix.FormularioPedido (Titulo = 'Alteração indevida', Descricao = 'Tentativa de alterar um pedido fechado.', Prioridade = CampusFix.Prioridade.Alta, VersaoOriginal = $P/Versao, CampusFix.Formulario_Categoria = $Cat, CampusFix.Formulario_Pedido = $P);
$Resultado = call microflow CampusFix.SUB_Pedido_Guardar(Formulario = $Form, Actor = $A);
/

