/**
 * @test RF04 edição válida mantém autor e data de criação
 * @expect $Resultado != empty
 * @expect $P/Titulo = 'Computador da sala 12'
 * @expect $P/CampusFix.Pedido_Criador = $A
 * @expect $P/DataCriacao = $DataOriginal
 * @cleanup rollback
 */
$F = call microflow CampusFixTest.CriarFixture();
retrieve $P from $F/CampusFixTest.Fixture_Pedido;
retrieve $A from $F/CampusFixTest.Fixture_A;
retrieve $B from $F/CampusFixTest.Fixture_B;
retrieve $T1 from $F/CampusFixTest.Fixture_T1;
retrieve $T2 from $F/CampusFixTest.Fixture_T2;
retrieve $Cat from $F/CampusFixTest.Fixture_Categoria;
declare $DataOriginal DateTime = $P/DataCriacao;
$Form = create CampusFix.FormularioPedido (Titulo = 'Computador da sala 12', Descricao = 'O computador não dá sinal de energia.', Prioridade = CampusFix.Prioridade.Urgente, VersaoOriginal = $P/Versao, CampusFix.Formulario_Categoria = $Cat, CampusFix.Formulario_Pedido = $P);
$Resultado = call microflow CampusFix.SUB_Pedido_Guardar(Formulario = $Form, Actor = $A);
/

/**
 * @test RF06 comentário guarda pedido autor e data certos
 * @expect $Feito = true
 * @expect $Nota/CampusFix.Comentario_Autor = $A
 * @expect $Nota/CampusFix.Comentario_Pedido = $P
 * @expect $Nota/DataComentario != empty
 * @cleanup rollback
 */
$F = call microflow CampusFixTest.CriarFixture();
retrieve $P from $F/CampusFixTest.Fixture_Pedido;
retrieve $A from $F/CampusFixTest.Fixture_A;
retrieve $B from $F/CampusFixTest.Fixture_B;
retrieve $T1 from $F/CampusFixTest.Fixture_T1;
retrieve $T2 from $F/CampusFixTest.Fixture_T2;
retrieve $Cat from $F/CampusFixTest.Fixture_Categoria;
$Form = create CampusFix.FormularioComentario (Texto = 'A tomada funciona com outro equipamento.', CampusFix.FormularioComentario_Pedido = $P);
$Feito = call microflow CampusFix.SUB_Comentario_Registar(Formulario = $Form, Actor = $A);
retrieve $Nota from CampusFix.Comentario where [CampusFix.Comentario_Pedido = $P] first;
/

