/**
 * @test Validação rejeita título demasiado curto
 * @expect $Erro = 'O título deve ter pelo menos 3 caracteres.'
 * @cleanup rollback
 */
$Form = create CampusFix.FormularioPedido (Titulo = ' ');
$Erro = call microflow CampusFix.SUB_Formulario_Validar(Formulario = $Form);
/
